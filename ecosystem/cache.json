 "extensions": [
  {
   "name": "claims",
   "label": "Claims",
   "description": "Forecasts anyone can check: a claim bar in the editor, a badge on posts with a claim, pinning and resolving from the post, and a Claims page with your score.",
   "shipped": true,
   "server": false
  },
  {
   "name": "bars-example",
   "label": "Editor bar example",
   "description": "Adds a bar above the editor\u2019s text box: insert a mark at the cursor, show or hide held-out text, and underline every TODO. For trying editor bars and marks.",
   "shipped": false,
   "server": false
  },
  {
   "name": "regions-example",
   "label": "Held-out paragraphs example",
   "description": "Hides paragraphs that start with [held]: # in the full editor, read-only when shown. For trying editor regions.",
   "shipped": false,
   "server": false
  },
  {
   "name": "inspect",
   "label": "Inspect",
   "description": "Adds \u201cinspect\u201d to each reading entry\u2019s \u22ef sheet: the record this Studio holds for it \u2014 ids, versions, references, hashes \u2014 and its JSON.",
   "shipped": true,
   "server": false
  },
  {
   "name": "lineage-glyph",
   "label": "Lineage glyph",
   "description": "A glyph in each reading byline for what a post draws on and what draws on it here, opening a hex view that shows what stub, quote, fork, link, history and open would each make.",
   "shipped": false,
   "server": true
  },
  {
   "name": "menu-example",
   "label": "Main menu example",
   "description": "Adds a page to the main menu, above compose. For trying the main-menu entry.",
   "shipped": false,
   "server": false
  },
  {
   "name": "feed-example",
   "label": "Pinned-first home page",
   "description": "Adds a home page order with pinned items at the top. Choose it under Settings \u2192 home page once enabled.",
   "shipped": false,
   "server": true
  },
  {
   "name": "reading-time",
   "label": "Reading time",
   "description": "Shows an estimated reading time and word count at the end of each reading entry\u2019s byline.",
   "shipped": true,
   "server": false
  },
  {
   "name": "spellcheck",
   "label": "Spellcheck",
   "description": "Spellcheck in the editor, in place of the browser\u2019s: misspellings underlined as you type, a US English check with suggestions using the blyg\u2019s dictionary, and an AI proofread of the draft.",
   "shipped": false,
   "server": true
  },
  {
   "name": "menu-top-example",
   "label": "Top of the menu example",
   "description": "Adds a page to the top of the main menu, above reading. For trying menu zones.",
   "shipped": false,
   "server": false
  },
  {
   "name": "word-count",
   "label": "Word count",
   "description": "Shows each entry\u2019s word count at the end of its byline and beside the character count while writing, published and in draft, and for a thread whose list of links forms an outline, such as a table of contents, the words in the whole document under it.",
